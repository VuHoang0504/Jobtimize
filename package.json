{
  "name": "jobtimize",
  "version": "1.0.0",
  "description": "Jobtimize - AI-Powered Recruitment Platform (Fullstack Monorepo)",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "npx concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "db:init": "npm --prefix server run db:init",
    "seed:jobs": "npm --prefix server run seed:jobs",
    "build": "npm --prefix client run build"
  },
  "keywords": [
    "recruitment",
    "ai",
    "react",
    "nodejs",
    "mssql"
  ],
  "author": "Jobtimize Team",
  "license": "ISC"
}
