{
  "name": "jobtimize",
  "version": "1.0.0",
  "description": "Jobtimize - AI-Powered Recruitment Platform (Fullstack Monorepo)",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "npx concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "db:init": "npm --prefix server run db:init",
    "seed:jobs": "npm --prefix server run seed:jobs",
    "build": "npm --prefix client run build",
    "cv:browser": "node scripts/installCVBrowser.mjs",
    "test:cv": "node --test server/scripts/test_cv_builder.mjs server/scripts/test_cv_api.mjs",
    "test:cv:ui": "node --test server/scripts/test_cv_editor_ui.mjs",
    "seed:browse": "npm --prefix server run seed:browse",
    "test:ai": "npm --prefix server run test:ai",
    "test:notifications": "npm --prefix server run test:notifications && npm --prefix client run test:notifications",
    "check:ai": "npm --prefix server run check:ai --"
  },
  "keywords": [
    "recruitment",
    "ai",
    "react",
    "nodejs",
    "mssql"
  ],
  "author": "Jobtimize Team",
  "license": "ISC"
}
