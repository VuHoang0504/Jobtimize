{
  "name": "jobtimize-server",
  "version": "1.0.0",
  "description": "Backend API for Jobtimize AI Recruitment Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node scripts/initDb.js",
    "seed:jobs": "node scripts/seedJobs.js",
    "check:smtp": "node scripts/check_smtp.js",
    "test:otp": "node --test scripts/test_otp.js",
    "test:notifications": "node --test scripts/test_notifications.js",
    "benchmark:notifications": "node scripts/benchmark_notifications.js",
    "db:notifications": "node scripts/migrateNotifications.js",
    "cv:browser": "node ../scripts/installCVBrowser.mjs",
    "seed:browse": "node scripts/seedBrowseJobs.js",
    "test:ai": "node --test scripts/test_openai.js scripts/test_content_generation.js",
    "check:ai": "node scripts/check_ai.js"
  },
  "keywords": [
    "recruitment",
    "ai",
    "job-matching",
    "mssql",
    "express"
  ],
  "author": "Jobtimize Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@payos/node": "^2.0.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "morgan": "^1.10.0",
    "mssql": "^10.0.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
