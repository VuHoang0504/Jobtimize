# Server Configuration
PORT=5000
NODE_ENV=development

# MS SQL Server Database Configuration
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourPassword123
DB_NAME=JobtimizeDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Authentication
JWT_SECRET=Jobtimize_Secret_Key_Super_Secure_2024_Token!
JWT_EXPIRES_IN=7d

# File Upload Directory
UPLOAD_DIR=uploads/

# Content provider: auto prefers OpenAI when its key is present, otherwise Gemini,
# then local processing. Use openai or gemini to select explicitly.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT_TOKENS=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=131834316524-ramequhjdc5icd9b9j65vauh3l7klfdg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gmail SMTP Email Verification
# Use a Google App Password. Restart the server after changing these values.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Optional: use another authenticated SMTP provider instead of Gmail.
# SMTP_HOST=smtp.provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@your-domain.com


# Automatic Premium checkout. Keep real credentials in .env only.
FRONTEND_URL=http://127.0.0.1:3000
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Register a public HTTPS webhook pointing to /api/payments/payos-webhook in PayOS.
