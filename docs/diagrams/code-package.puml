@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
package "client.pages" as pages
package "client.components" as components
package "client.context" as context
package "client.services" as api
package "server.routes" as routes
package "server.middleware" as middleware
